# Neon Postgres connection string (get from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Admin passwords (comma-separated, used by /api/admin/login)
ADMIN_PASSWORDS=admin123,chayka,1234

# Test database URL used by server integration tests
# Leave unset in environments that should not run the integration suite.
TEST_DATABASE_URL=

# Express server port (Vite proxies /api/* to this)
PORT=3001
