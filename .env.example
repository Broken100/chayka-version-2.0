# Neon Postgres connection string (get from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Admin passwords (comma-separated, used by /api/admin/login)
ADMIN_PASSWORDS=admin123,chayka,1234

# Secret used to sign admin session cookies (use a random 32+ char string)
SESSION_SECRET=change-me-to-a-long-random-string

# Express server port (Vite proxies /api/* to this)
PORT=3001
